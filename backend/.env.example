# AI Job Hunter - Backend Configuration

PROJECT_NAME="AI Job Hunter"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True

# Database (PostgreSQL for Supabase/Render/Railway/Docker, or SQLite for zero-config local run)
# Example PostgreSQL URL: postgresql+psycopg2://postgres:password@localhost:5432/ai_job_hunter
# Example Supabase URL: postgresql+psycopg2://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL="sqlite:///./ai_job_hunter.db"

# JWT Authentication
SECRET_KEY="generate_a_secure_random_key_here_for_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Gmail OAuth & API Credentials
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:5173/auth/gmail/callback"

# Optional AI APIs (Gemini or OpenAI)
# If left empty, the built-in deterministic rule-based NLP engine will be used automatically
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.1-flash-lite"
OPENAI_API_KEY=""

# Optional Search Engine Career Page Discovery (Google Custom Search API)
# If left empty, the engine uses public search discovery across Greenhouse, Lever, Ashby, and Workable
GOOGLE_SEARCH_API_KEY=""
GOOGLE_SEARCH_ENGINE_ID=""

